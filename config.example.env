# Copy to .env and fill in your bridge address and reviewed radio settings.
# Python does not load this file automatically; see docs/setup.md.
SOLAR_RADIO_HOST=
SOLAR_RADIO_PORT=6638
SOLAR_RADIO_CHANNEL=
SOLAR_PAN_ID=
SOLAR_EXTENDED_PAN_ID=
SOLAR_COLLECTOR_EUI=
SOLAR_INVERTER_EUI=
# SOLAR_INITIAL_ADDRESS is optional; normally let the collector learn the address.
# To run the included dashboard in the same container, set SOLAR_DASHBOARD=true.
