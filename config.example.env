# Discover and fill these settings with tools/discover_radio.py --write-env .env.
# Load with uv run --env-file .env or Docker --env-file .env; see docs/setup.md.
SOLAR_RADIO_HOST=
SOLAR_RADIO_PORT=6638
SOLAR_RADIO_CHANNEL=
SOLAR_PAN_ID=
SOLAR_EXTENDED_PAN_ID=
SOLAR_COLLECTOR_EUI=
SOLAR_INVERTER_EUI=
# SOLAR_INITIAL_ADDRESS is optional; normally let the collector learn the address.
# SOLAR_POLL_INTERVAL_SECONDS=60
# SOLAR_RECONNECT_INTERVAL_SECONDS=15
# SOLAR_COLLECTOR_MODE=replacement
# Use passive to listen alongside a working original box (experimental).
# SOLAR_PASSIVE_STALE_SECONDS=300
# To run the included dashboard in the same container, set SOLAR_DASHBOARD=true.
