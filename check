#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
unset SOLAR_CONFIG SOLAR_RADIO_HOST SOLAR_RADIO_PORT SOLAR_RADIO_CHANNEL SOLAR_PAN_ID \
  SOLAR_EXTENDED_PAN_ID SOLAR_COLLECTOR_EUI SOLAR_INVERTER_EUI SOLAR_INITIAL_ADDRESS \
  SOLAR_POLL_INTERVAL_SECONDS SOLAR_RECONNECT_INTERVAL_SECONDS \
  SOLAR_COLLECTOR_MODE SOLAR_PASSIVE_STALE_SECONDS
set -a
. ./tests/radio.synthetic.env
set +a
uv run --locked --no-env-file python -m unittest discover -s tests -p 'test_*.py'
node --test tests/dashboard.test.cjs
uv run --locked --no-env-file python tools/check_publication.py
